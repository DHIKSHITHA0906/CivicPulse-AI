# Set to "false" once the backend is deployed and reachable.
# Default (unset or "true") = frontend runs entirely on mocked data,
# matching the API contract in src/api.js — no code changes needed
# to switch.
VITE_USE_MOCKS=true

# Member 3's deployed backend base URL (only used when VITE_USE_MOCKS=false).
VITE_BACKEND_BASE_URL=
